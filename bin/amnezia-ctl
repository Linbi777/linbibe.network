#!/usr/bin/env python3
"""Drive AmneziaVPN from the Omarchy bar.

Amnezia ships no session CLI. The GUI accepts `--connect <index>` only on
startup, and a second instance just raises the window. Connect restarts the
GUI with `--connect`. Disconnect SIGTERMs the GUI so its destructor can ask
the privileged service to drop tun2socks / tun2 / XRay — then leaves the GUI
dead. Restarting with `--autostart` (or SIGKILL mid-teardown) leaves the
tunnel up while the chip looks off, which breaks other VPNs such as Docker.

Status is read from QSettings (server names only) plus Amnezia's own
processes/interfaces — never from NetworkManager, which adopts Amnezia's tun
device and would otherwise claim it.
"""

from __future__ import annotations

import json
import os
import re
import shlex
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

APP_NAMES = ("AmneziaVPN",)
SERVICE_UNIT = "AmneziaVPN.service"
BINARIES = (
    Path("/usr/bin/AmneziaVPN"),
    Path("/opt/AmneziaVPN/bin/AmneziaVPN"),
)
CONFIG_CANDIDATES = (
    Path.home() / ".config/AmneziaVPN.ORG/AmneziaVPN.conf",
    Path.home() / ".config/AmneziaVPN.ORG/AmneziaVPN/AmneziaVPN.conf",
)
# Anchored so `docker run ... tun2socks` in some other argv cannot match.
TUNNEL_PROCS = (
    "^/opt/AmneziaVPN/bin/tun2socks",
    "^/opt/AmneziaVPN/bin/amneziawg-go",
    "^/opt/AmneziaVPN/bin/openvpn",
    "/tmp/AmneziaVPN.run",
)
# XRay in the official client always names the device tun2.
XRAY_TUN = "tun2"
CONTAINER_LABELS = {
    "amnezia-xray": "XRay",
    "amnezia-awg": "AmneziaWG",
    "amnezia-wireguard": "WireGuard",
    "amnezia-openvpn": "OpenVPN",
    "amnezia-openvpn-cloak": "OpenVPN Cloak",
    "amnezia-ss": "Shadowsocks",
    "amnezia-ikev2": "IKEv2",
}


def which_app() -> Path | None:
    for candidate in BINARIES:
        if candidate.exists():
            return candidate
    return None


def pgrep_exact(name: str) -> list[int]:
    try:
        out = subprocess.check_output(["pgrep", "-x", name], text=True)
    except subprocess.CalledProcessError:
        return []
    return [int(line) for line in out.splitlines() if line.strip().isdigit()]


def pgrep_full(needle: str) -> list[int]:
    try:
        out = subprocess.check_output(["pgrep", "-f", needle], text=True)
    except subprocess.CalledProcessError:
        return []
    return [int(line) for line in out.splitlines() if line.strip().isdigit()]


def service_running() -> bool:
    try:
        result = subprocess.run(
            ["systemctl", "is-active", "--quiet", SERVICE_UNIT],
            check=False,
        )
        return result.returncode == 0
    except OSError:
        return bool(pgrep_exact("AmneziaVPN-service"))


def app_pids() -> list[int]:
    return pgrep_exact("AmneziaVPN")


def tunnel_pids() -> list[int]:
    found: list[int] = []
    for needle in TUNNEL_PROCS:
        found.extend(pgrep_full(needle))
    return found


def tunnel_iface() -> str:
    try:
        links = json.loads(subprocess.check_output(["ip", "-j", "link"], text=True))
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
        return ""
    names = []
    for link in links:
        name = str(link.get("ifname") or "")
        flags = link.get("flags") or []
        if "UP" not in flags:
            continue
        if name.startswith("amn") or name == XRAY_TUN:
            names.append(name)
    if any(name.startswith("amn") for name in names):
        return next(name for name in names if name.startswith("amn"))
    return names[0] if names else ""


def connected() -> bool:
    if tunnel_pids():
        return True
    iface = tunnel_iface()
    if iface.startswith("amn") or iface == XRAY_TUN:
        return True
    return False


def unescape_qt(text: str) -> str:
    out: list[str] = []
    i = 0
    while i < len(text):
        if text[i] == "\\" and i + 1 < len(text):
            nxt = text[i + 1]
            mapping = {"n": "\n", "t": "\t", "r": "\r", '"': '"', "\\": "\\"}
            if nxt in mapping:
                out.append(mapping[nxt])
                i += 2
                continue
            if nxt == "x" and i + 3 < len(text):
                try:
                    out.append(chr(int(text[i + 2 : i + 4], 16)))
                    i += 4
                    continue
                except ValueError:
                    pass
            out.append(nxt)
            i += 2
            continue
        out.append(text[i])
        i += 1
    return "".join(out)


def read_conf() -> str:
    for path in CONFIG_CANDIDATES:
        try:
            return path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
    return ""


def parse_servers(conf: str) -> tuple[list[dict], str]:
    default_id = ""
    match_id = re.search(r"^defaultServerId=(.*)$", conf, re.M)
    if match_id:
        default_id = match_id.group(1).strip().strip('"')

    match = re.search(r'serversList="@ByteArray\((.*)\)"\s*(?:\n|$)', conf, re.S)
    if not match:
        match = re.search(r"serversList=@ByteArray\((.*)\)\s*(?:\n|$)", conf, re.S)
    if not match:
        return [], default_id

    try:
        payload = json.loads(unescape_qt(match.group(1)))
    except json.JSONDecodeError:
        return [], default_id
    if not isinstance(payload, list):
        return [], default_id

    servers = []
    for index, raw in enumerate(payload):
        if not isinstance(raw, dict):
            continue
        container = str(raw.get("defaultContainer") or "")
        containers = raw.get("containers") or []
        if not container and isinstance(containers, list):
            for item in containers:
                if isinstance(item, dict) and item.get("container"):
                    container = str(item["container"])
                    break
        identity = str(
            raw.get("id")
            or raw.get("storageServerId")
            or raw.get("uuid")
            or ""
        )
        name = str(
            raw.get("name")
            or raw.get("description")
            or raw.get("hostName")
            or f"Server {index + 1}"
        )
        protocol = CONTAINER_LABELS.get(container, "")
        if not protocol and container.startswith("amnezia-"):
            protocol = container[len("amnezia-") :].replace("-", " ")
        servers.append(
            {
                "index": index,
                "key": f"server:{index}",
                "name": name,
                "protocol": protocol,
                "container": container,
                "id": identity,
            }
        )
    return servers, default_id


def current_index(servers: list[dict], default_id: str, is_up: bool) -> int:
    if not is_up:
        for server in servers:
            if default_id and server["id"] == default_id:
                return int(server["index"])
        return 0 if servers else -1
    if default_id:
        for server in servers:
            if server["id"] == default_id:
                return int(server["index"])
    return 0 if servers else -1


def status_payload(error: str = "") -> dict:
    binary = which_app()
    servers, default_id = parse_servers(read_conf())
    is_up = connected()
    idx = current_index(servers, default_id, is_up)
    current = next((row for row in servers if row["index"] == idx), None)
    installed = binary is not None
    svc = service_running()
    hint = ""
    if not installed:
        hint = "Install AmneziaVPN to manage it from this chip"
    elif not servers:
        hint = "Add a server in the AmneziaVPN app"
    elif not svc:
        hint = "Start AmneziaVPN.service so the client can bring a tunnel up"

    summary = "Disconnected"
    if is_up and current:
        summary = (
            f"{current['name']} · {current['protocol']}"
            if current["protocol"]
            else current["name"]
        )
    elif is_up:
        summary = "Connected"

    return {
        "ok": error == "",
        "detected": installed and (len(servers) > 0 or is_up),
        "installed": installed,
        "serviceRunning": svc,
        "appRunning": len(app_pids()) > 0,
        "connected": is_up,
        "setupHint": hint,
        "error": error,
        "iface": tunnel_iface() if is_up else "",
        "currentIndex": idx if is_up else (idx if current else -1),
        "currentKey": current["key"] if (is_up and current) else "",
        "summary": summary if is_up else "",
        "servers": servers,
    }


def emit(payload: dict) -> int:
    json.dump(payload, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")
    return 0 if payload.get("ok", True) else 1


def signal_pids(pids: list[int], sig: signal.Signals) -> None:
    for pid in pids:
        try:
            os.kill(pid, sig)
        except ProcessLookupError:
            continue
        except PermissionError:
            continue


def stop_user_xray() -> None:
    pids = pgrep_full("/tmp/AmneziaVPN.run")
    signal_pids(pids, signal.SIGTERM)
    time.sleep(0.2)
    signal_pids(pgrep_full("/tmp/AmneziaVPN.run"), signal.SIGKILL)


def daemon_deactivate() -> None:
    # Mozilla-style daemon used by AmneziaWG. Harmless no-op for XRay, but
    # it is the only unprivileged stop API on the service socket.
    path = "/var/run/amneziavpn/daemon.socket"
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(2)
        sock.connect(path)
        sock.sendall(b'{"type":"deactivate"}\n')
        try:
            sock.recv(256)
        except OSError:
            pass
        sock.close()
    except OSError:
        return


def docker_drop_tunnel() -> str:
    # Passwordless leftover cleanup: the user is in the docker group.
    # Runs amnezia-drop-tun against the host (pid/net) so killswitch/DNS/IPv6
    # are restored, not just tun2 deleted.
    helper = Path(__file__).resolve().with_name("amnezia-drop-tun")
    if not helper.is_file():
        return "missing amnezia-drop-tun"
    try:
        os.chmod(helper, 0o755)
    except OSError:
        pass
    image = "vpn:with_certs"
    try:
        probed = subprocess.check_output(
            ["/usr/bin/docker", "inspect", "-f", "{{.Config.Image}}", "vpn_reserve"],
            text=True,
            timeout=3,
            stderr=subprocess.DEVNULL,
        ).strip()
        if probed:
            image = probed
    except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
        pass
    try:
        result = subprocess.run(
            [
                "/usr/bin/docker",
                "run",
                "--rm",
                "--privileged",
                "--pid=host",
                "--network",
                "host",
                "-v",
                f"{helper}:/amnezia-drop-tun:ro",
                "--entrypoint",
                "/bin/sh",
                image,
                "/amnezia-drop-tun",
            ],
            check=False,
            capture_output=True,
            text=True,
            timeout=45,
        )
    except subprocess.TimeoutExpired:
        return "docker cleanup timed out"
    except OSError as exc:
        return str(exc)
    if result.returncode != 0:
        err = (result.stderr or result.stdout or "").strip()
        return err or f"docker exited {result.returncode}"
    return ""


def pkexec_drop_tunnel() -> str:
    helper = Path(__file__).with_name("amnezia-drop-tun")
    if not helper.is_file():
        return "missing amnezia-drop-tun"
    try:
        os.chmod(helper, 0o755)
    except OSError:
        pass
    try:
        result = subprocess.run(
            ["pkexec", str(helper)],
            check=False,
            capture_output=True,
            text=True,
            timeout=60,
        )
    except subprocess.TimeoutExpired:
        return "polkit prompt timed out"
    except OSError as exc:
        return str(exc)
    if result.returncode != 0:
        err = (result.stderr or result.stdout or "").strip()
        return err or f"pkexec exited {result.returncode}"
    return ""


def drop_privileged_tunnel() -> str:
    docker_err = docker_drop_tunnel()
    if docker_err == "":
        restore_user_network()
        return ""
    pkexec_err = pkexec_drop_tunnel()
    restore_user_network()
    if pkexec_err == "":
        return ""
    return pkexec_err or docker_err


def sysctl_ipv6_disabled(iface: str) -> bool:
    path = Path(f"/proc/sys/net/ipv6/conf/{iface}/disable_ipv6")
    try:
        return path.read_text(encoding="ascii").strip() == "1"
    except OSError:
        return False


def wifi_device() -> str:
    try:
        out = subprocess.check_output(
            ["nmcli", "-t", "-f", "DEVICE,TYPE,STATE", "device", "status"],
            text=True,
            timeout=3,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
        return ""
    for line in out.splitlines():
        parts = line.split(":")
        if len(parts) >= 3 and parts[1] == "wifi" and parts[2] == "connected":
            return parts[0]
    return ""


def restore_user_network() -> None:
    wifi = wifi_device()
    try:
        subprocess.run(
            ["resolvectl", "flush-caches"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=3,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass
    if not wifi:
        return
    try:
        subprocess.run(
            ["nmcli", "device", "reapply", wifi],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=8,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


def leftover_after_drop() -> str:
    if connected():
        return "Amnezia tunnel is still up"
    if Path("/sys/class/net/tun2").exists():
        return "tun2 is still present"
    if sysctl_ipv6_disabled("all") or sysctl_ipv6_disabled("default"):
        wifi = wifi_device()
        if wifi and sysctl_ipv6_disabled(wifi):
            return "IPv6 is still disabled on Wi-Fi (Amnezia leftover)"
        return "IPv6 is still globally disabled (Amnezia leftover)"
    return ""


def ping_ok(host: str, timeout: int = 2) -> bool:
    try:
        result = subprocess.run(
            ["ping", "-c", "1", f"-W{timeout}", host],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=timeout + 2,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0


def curl_ok(url: str) -> bool:
    try:
        result = subprocess.run(
            ["curl", "-4", "-sS", "-o", "/dev/null", "-m", "5", url],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=8,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0


def default_gateway() -> str:
    try:
        routes = json.loads(
            subprocess.check_output(
                ["ip", "-j", "route", "show", "default"],
                text=True,
                timeout=3,
            )
        )
    except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired, json.JSONDecodeError):
        return ""
    if not isinstance(routes, list):
        return ""
    for row in routes:
        gw = row.get("gateway")
        if gw:
            return str(gw)
    return ""


def probe_plain_internet() -> str:
    gw = default_gateway()
    if not gw:
        return "no default route after disconnect"
    if not ping_ok(gw):
        return f"gateway {gw} unreachable"
    if curl_ok("https://1.1.1.1") or ping_ok("1.1.1.1", 3):
        return ""
    return "no IPv4 to the internet on Wi-Fi"


def stop_gui(timeout: float = 20.0, force: bool = False) -> None:
    # SIGTERM runs ~AmneziaApplication, which BlockingQueued-calls
    # disconnectFromVpn. The privileged tun2socks / tun2 live under
    # AmneziaVPN-service, so SIGKILL here skips teardown and leaves them up.
    signal_pids(app_pids(), signal.SIGTERM)
    wait_until(lambda: not app_pids(), timeout, 0.1)
    if force:
        signal_pids(app_pids(), signal.SIGKILL)
        wait_until(lambda: not app_pids(), 2, 0.1)


def hypr_dispatch(lua: str) -> None:
    try:
        subprocess.run(
            ["hyprctl", "dispatch", lua],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=2,
        )
    except (OSError, subprocess.TimeoutExpired):
        return


def start_gui(extra: list[str]) -> None:
    binary = which_app()
    if binary is None:
        raise FileNotFoundError("AmneziaVPN is not installed")
    # Spawn through Hyprland so the window is born on a silent workspace
    # instead of flashing on the current one. --connect only works as a
    # first instance, so this is the only moment the GUI has to exist.
    cmd = " ".join(shlex.quote(part) for part in [str(binary), *extra])
    lua = (
        f"hl.dsp.exec_cmd({json.dumps(cmd)}, "
        '{ workspace = "special:amnezia silent", no_initial_focus = true, '
        "no_anim = true })"
    )
    try:
        result = subprocess.run(
            ["hyprctl", "dispatch", lua],
            check=False,
            capture_output=True,
            text=True,
            timeout=3,
        )
        if result.returncode == 0 and "error" not in (result.stdout + result.stderr).lower():
            return
    except (OSError, subprocess.TimeoutExpired):
        pass
    env = os.environ.copy()
    env.setdefault("QT_QPA_PLATFORM", "wayland;xcb")
    subprocess.Popen(
        [str(binary), *extra],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        env=env,
    )


def hide_window() -> None:
    # Amnezia treats a close request as hide-to-tray (it never quits).
    # Hyprland 0.55+ only accepts Lua dispatchers; the old closewindow
    # form was a no-op, which is why the window kept popping up.
    hypr_dispatch('hl.dsp.window.close({ window = "class:AmneziaVPN" })')
    hypr_dispatch(
        'hl.dsp.window.move({ workspace = "special:amnezia", follow = false, '
        'window = "class:AmneziaVPN" })'
    )


def wait_until(predicate, timeout: float, interval: float = 0.4) -> bool:
    deadline = time.time() + timeout
    while time.time() < deadline:
        if predicate():
            return True
        time.sleep(interval)
    return predicate()


def shutdown_client() -> str:
    # Destructor never drops tun2socks. SIGKILL the GUI first so it cannot
    # respawn the tunnel after we delete tun2, then restore host networking.
    stop_gui(timeout=4.0, force=True)
    stop_user_xray()
    daemon_deactivate()
    drop_error = drop_privileged_tunnel()
    if app_pids():
        stop_gui(timeout=2.0, force=True)
        stop_user_xray()
        again = drop_privileged_tunnel()
        drop_error = drop_error or again
    return drop_error


def do_connect(index: int) -> dict:
    servers, _ = parse_servers(read_conf())
    if not any(server["index"] == index for server in servers):
        payload = status_payload(f"No Amnezia server at index {index}")
        payload["ok"] = False
        return payload
    if not service_running():
        payload = status_payload("AmneziaVPN.service is not running")
        payload["ok"] = False
        return payload
    shutdown_client()
    if app_pids():
        # --connect is ignored on a second instance; the running GUI must go.
        stop_gui(timeout=2.0, force=True)
    start_gui(["--connect", str(index)])
    wait_until(lambda: len(app_pids()) > 0, 5)

    def up_and_hidden() -> bool:
        hide_window()
        return connected()

    wait_until(up_and_hidden, 20, 0.15)
    hide_window()
    payload = status_payload()
    if not payload["connected"]:
        payload["ok"] = False
        payload["error"] = "Amnezia did not come up after --connect"
    return payload


def do_disconnect() -> dict:
    drop_error = shutdown_client()
    wait_until(lambda: leftover_after_drop() == "", 4, 0.25)
    leftover = leftover_after_drop() or drop_error
    if not leftover:
        leftover = probe_plain_internet()
    payload = status_payload(leftover)
    if leftover:
        payload["ok"] = False
        payload["error"] = leftover
    return payload


def do_repair() -> dict:
    drop_error = drop_privileged_tunnel()
    leftover = leftover_after_drop() or drop_error
    if not leftover:
        leftover = probe_plain_internet()
    payload = status_payload(leftover)
    if leftover:
        payload["ok"] = False
        payload["error"] = leftover
    return payload


def main(argv: list[str]) -> int:
    if len(argv) <= 1 or argv[1] in ("status", "list"):
        return emit(status_payload())
    command = argv[1]
    if command == "connect":
        if len(argv) < 3:
            return emit(status_payload("connect needs a server index"))
        try:
            index = int(argv[2])
        except ValueError:
            return emit(status_payload(f"Not a server index: {argv[2]}"))
        return emit(do_connect(index))
    if command == "disconnect":
        return emit(do_disconnect())
    if command == "repair":
        return emit(do_repair())
    return emit(status_payload(f"Unknown command: {command}"))


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except KeyboardInterrupt:
        raise SystemExit(130)
